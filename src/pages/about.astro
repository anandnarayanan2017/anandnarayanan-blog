---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../consts";
---
<BaseLayout title="About" nav="about">
  <article class="article">
    <div class="eyebrow">About</div>
    <h1>{SITE.name}</h1>
    <div class="post-content">
      <p>I work full time as a Solutions Architect based in Luxembourg.</p>
      <p>{SITE.intro}</p>
      <h2>Personal writing and projects</h2>
      <p>This blog and projects such as Agent Sentinel are independent personal pursuits that I work on in my spare time, alongside my full-time role.</p>
      <p>Find me on <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>, or contact me at <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.</p>
    </div>
  </article>
</BaseLayout>
