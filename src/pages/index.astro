---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE } from "../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() ||
    (a.data.part ?? 0) - (b.data.part ?? 0)
);
const tags = ["All", ...new Set(posts.flatMap((p) => p.data.tags))];
const fmt = (d) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout>
  <main class="max-w-3xl mx-auto px-5">
    <section class="py-12 sm:py-16">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight mb-4 text-slate-900 dark:text-white">{SITE.tagline}</h1>
      <p class="text-lg leading-relaxed max-w-xl text-slate-600 dark:text-slate-400">{SITE.intro}</p>
    </section>

    <a href={SITE.series}
      class="group block rounded-2xl border p-6 mb-10 transition-all duration-200 hover:-translate-y-0.5 bg-white border-slate-200 hover:border-indigo-300 hover:shadow-lg dark:bg-slate-800/50 dark:border-slate-700 dark:hover:border-indigo-500/50">
      <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300">Series · 10 parts</span>
      <h3 class="text-xl font-bold leading-snug tracking-tight mt-3 mb-2 text-slate-900 group-hover:text-indigo-700 dark:text-white dark:group-hover:text-indigo-300">Agent Sentinel: a flight recorder for AI agents</h3>
      <p class="text-[15px] leading-relaxed text-slate-600 dark:text-slate-400">How to record, explain and export what AI agents do in regulated environments, with the design, code and tests behind each part. Start with Part 1.</p>
    </a>
    <p class="-mt-6 mb-10 text-sm text-slate-500">
      Code, tests and technical write-ups:{" "}
      <a href={SITE.seriesRepo} target="_blank" rel="noopener noreferrer" class="underline hover:text-indigo-600 dark:hover:text-indigo-400">github.com/anandnarayanan2017/anandnarayanan-blog</a>
    </p>

    {posts.length > 0 && <div class="flex flex-wrap gap-2 mb-8" id="tag-filter">
      {tags.map((t, i) => (
        <button data-tag={t}
          class:list={["tag-btn text-sm px-3.5 py-1.5 rounded-full font-medium transition-colors",
            i === 0 ? "bg-indigo-600 text-white" : "text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-800"]}>
          {t}
        </button>
      ))}
    </div>}

    <section class="grid gap-5 pb-16" id="post-list">
      {posts.map((p) => (
        <a href={`/blog/${p.id}/`} data-tags={p.data.tags.join(",")}
          class="post-card group block rounded-2xl border p-6 transition-all duration-200 hover:-translate-y-0.5 bg-white border-slate-200 hover:border-indigo-300 hover:shadow-lg dark:bg-slate-800/50 dark:border-slate-700 dark:hover:border-indigo-500/50 dark:hover:bg-slate-800">
          <div class="flex flex-wrap gap-2 mb-3">
            {p.data.tags.map((t) => (
              <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300">{t}</span>
            ))}
          </div>
          <h3 class="text-xl font-bold leading-snug tracking-tight mb-2 text-slate-900 group-hover:text-indigo-700 dark:text-white dark:group-hover:text-indigo-300">{p.data.title}</h3>
          <p class="text-[15px] leading-relaxed mb-4 text-slate-600 dark:text-slate-400">{p.data.excerpt}</p>
          <div class="flex items-center gap-4 text-sm text-slate-500">
            <span>{fmt(p.data.date)}</span>
            {p.data.readTime && <span>{p.data.readTime} min read</span>}
          </div>
        </a>
      ))}
    </section>
  </main>

  <script>
    const buttons = document.querySelectorAll(".tag-btn");
    const cards = document.querySelectorAll(".post-card");
    buttons.forEach((btn) =>
      btn.addEventListener("click", () => {
        const tag = btn.getAttribute("data-tag");
        buttons.forEach((b) => {
          b.classList.remove("bg-indigo-600", "text-white");
          b.classList.add("text-slate-600", "dark:text-slate-300");
        });
        btn.classList.add("bg-indigo-600", "text-white");
        btn.classList.remove("text-slate-600", "dark:text-slate-300");
        cards.forEach((c) => {
          const tags = (c.getAttribute("data-tags") || "").split(",");
          c.style.display = tag === "All" || tags.includes(tag) ? "" : "none";
        });
      })
    );
  </script>
</BaseLayout>
