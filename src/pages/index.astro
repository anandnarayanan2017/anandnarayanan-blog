---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE } from "../consts";
import { homeJsonLd } from "../structured-data";
import { getSeries } from "../series";

const posts = (await getCollection("blog")).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() ||
    (a.data.part ?? 0) - (b.data.part ?? 0)
);
const tags = ["All", ...new Set(posts.flatMap((p) => p.data.tags))];
const series = getSeries(posts);
const fmt = (d) => d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---
<BaseLayout title={`${SITE.name} — ${SITE.headline}`} jsonLd={homeJsonLd()}>
  <main class="max-w-3xl mx-auto px-5">
    <section class="py-12 sm:py-16">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight mb-4 text-slate-900 dark:text-white">{SITE.headline}</h1>
      <p class="text-xl leading-relaxed max-w-2xl text-slate-700 dark:text-slate-300">{SITE.tagline}</p>
      <p class="mt-6 text-[15px] leading-relaxed max-w-2xl text-slate-600 dark:text-slate-400">{SITE.homeIntro}</p>
      <p class="mt-3 text-[15px] leading-relaxed max-w-2xl text-slate-500">{SITE.personalNote} <a href="/about/" class="underline hover:text-indigo-600 dark:hover:text-indigo-400">More about me</a>.</p>
    </section>

    {series.length > 0 && <section aria-labelledby="start-here" class="mb-14">
      <h2 id="start-here" class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Start here</h2>
      <p class="text-lg font-semibold mb-6 text-slate-900 dark:text-white">{SITE.question}</p>
      <div class:list={["grid gap-5", series.length > 1 && "sm:grid-cols-2"]}>
        {series.map((s) => (
          <div class="flex flex-col rounded-2xl border p-6 bg-white border-slate-200 dark:bg-slate-800/50 dark:border-slate-700">
            <span class="self-start text-xs font-medium px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300">{s.badge} · {s.parts.length} {s.parts.length === 1 ? "part" : "parts"} published</span>
            {s.question && <p class="mt-3 text-sm font-medium italic text-slate-500 dark:text-slate-400">{s.question}</p>}
            <h3 class="text-xl font-bold leading-snug tracking-tight mt-2 mb-2 text-slate-900 dark:text-white">{s.title}</h3>
            <p class="text-[15px] leading-relaxed mb-5 text-slate-600 dark:text-slate-400">{s.description}</p>
            <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 text-sm font-medium">
              <a href={`/blog/${s.parts[0].id}/`} class="text-indigo-600 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-indigo-300">Read Part 1: {s.parts[0].data.title.replace(/^.*Part 1: /, "")} →</a>
              {s.codeUrl && <a href={s.codeUrl} target="_blank" rel="noopener noreferrer" class="text-slate-500 underline hover:text-indigo-600 dark:hover:text-indigo-400">Source code on GitHub</a>}
            </div>
          </div>
        ))}
      </div>
    </section>}

    {posts.length > 0 && <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-4">Latest writing</h2>}
    {posts.length > 0 && <div class="flex flex-wrap gap-2 mb-8" id="tag-filter" role="group" aria-label="Filter posts by tag">
      {tags.map((t, i) => (
        <button type="button" data-tag={t} aria-pressed={i === 0 ? "true" : "false"}
          class:list={["tag-btn text-sm px-3.5 py-1.5 rounded-full font-medium transition-colors",
            i === 0 ? "bg-indigo-600 text-white" : "text-slate-600 hover:bg-slate-200 dark:text-slate-300 dark:hover:bg-slate-800"]}>
          {t}
        </button>
      ))}
    </div>}

    <section class="grid gap-5 pb-16" id="post-list">
      {posts.map((p) => (
        <a href={`/blog/${p.id}/`} data-tags={p.data.tags.join(",")}
          class="post-card group block rounded-2xl border p-6 transition-all duration-200 hover:-translate-y-0.5 bg-white border-slate-200 hover:border-indigo-300 hover:shadow-lg dark:bg-slate-800/50 dark:border-slate-700 dark:hover:border-indigo-500/50 dark:hover:bg-slate-800">
          <div class="flex flex-wrap gap-2 mb-3">
            {p.data.tags.map((t) => (
              <span class="text-xs font-medium px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 dark:bg-indigo-500/15 dark:text-indigo-300">{t}</span>
            ))}
          </div>
          <h3 class="text-xl font-bold leading-snug tracking-tight mb-2 text-slate-900 group-hover:text-indigo-700 dark:text-white dark:group-hover:text-indigo-300">{p.data.title}</h3>
          <p class="text-[15px] leading-relaxed mb-4 text-slate-600 dark:text-slate-400">{p.data.excerpt}</p>
          <div class="flex items-center gap-4 text-sm text-slate-500">
            <time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time>
            {p.data.readTime && <span>{p.data.readTime} min read</span>}
          </div>
        </a>
      ))}
    </section>

    <section aria-labelledby="acknowledgements" class="pb-16">
      <h2 id="acknowledgements" class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400 mb-2">Acknowledgements</h2>
      <p class="text-[15px] leading-relaxed max-w-2xl text-slate-600 dark:text-slate-400">{SITE.acknowledgement}</p>
    </section>
  </main>

  <script>
    const buttons = document.querySelectorAll(".tag-btn");
    const cards = document.querySelectorAll(".post-card");
    buttons.forEach((btn) =>
      btn.addEventListener("click", () => {
        const tag = btn.getAttribute("data-tag");
        buttons.forEach((b) => {
          b.setAttribute("aria-pressed", String(b === btn));
          b.classList.remove("bg-indigo-600", "text-white");
          b.classList.add("text-slate-600", "dark:text-slate-300");
        });
        btn.classList.add("bg-indigo-600", "text-white");
        btn.classList.remove("text-slate-600", "dark:text-slate-300");
        cards.forEach((c) => {
          const tags = (c.getAttribute("data-tags") || "").split(",");
          c.style.display = tag === "All" || tags.includes(tag) ? "" : "none";
        });
      })
    );
  </script>
</BaseLayout>
