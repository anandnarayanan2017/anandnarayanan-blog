---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE } from "../consts";
import { homeJsonLd } from "../structured-data";
import { getSeries } from "../series";

const posts = (await getCollection("blog")).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() ||
    (a.data.part ?? 0) - (b.data.part ?? 0)
);
const tags = ["All", ...new Set(posts.flatMap((p) => p.data.tags))];
const series = getSeries(posts);
const fmt = (d) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "2-digit", timeZone: "UTC" });
const iso = (d) => d.toISOString().slice(0, 10);
---
<BaseLayout title={`${SITE.name} — ${SITE.headline}`} jsonLd={homeJsonLd()}>
  <main class="container">
    <section class="hero">
      <h1>{SITE.headline}</h1>
      <p class="lead">{SITE.tagline}</p>
      <p class="intro">{SITE.homeIntro}</p>
      <p class="intro">{SITE.personalNote} <a href="/about/">More about me</a>.</p>
    </section>

    {series.length > 0 && <section aria-labelledby="start-here" class="section">
      <h2 id="start-here" class="eyebrow">Start here</h2>
      <p class="section-question">{SITE.question}</p>
      <div class:list={["grid", series.length > 1 && "grid-2"]}>
        {series.map((s) => (
          <div class="card">
            <span class="chip chip-accent">{s.badge} · {s.parts.length} {s.parts.length === 1 ? "part" : "parts"} published</span>
            {s.question && <p class="question">{s.question}</p>}
            <h3>{s.title}</h3>
            <p class="summary">{s.description}</p>
            <div class="card-links">
              <a href={`/blog/${s.parts[0].id}/`}>Read Part 1: {s.parts[0].data.title.replace(/^.*Part 1: /, "")} →</a>
              {s.codeUrl && <a href={s.codeUrl} target="_blank" rel="noopener noreferrer" class="secondary">Source code on GitHub</a>}
            </div>
          </div>
        ))}
      </div>
    </section>}

    {posts.length > 0 && <section aria-labelledby="latest" class="section">
      <h2 id="latest" class="eyebrow">Latest writing</h2>
      <div class="tag-filter" role="group" aria-label="Filter posts by tag">
        {tags.map((t, i) => (
          <button type="button" class="tag-btn" data-tag={t} aria-pressed={i === 0 ? "true" : "false"}>{t}</button>
        ))}
      </div>
      <div class="grid">
        {posts.map((p) => (
          <a href={`/blog/${p.id}/`} data-tags={p.data.tags.join(",")} class="card post-card">
            <ul class="tags" aria-label="Tags">
              {p.data.tags.map((t) => <li class="chip">#{t}</li>)}
            </ul>
            <h3>{p.data.title}</h3>
            <p class="summary">{p.data.excerpt}</p>
            <p class="meta">
              <time datetime={iso(p.data.date)}>{fmt(p.data.date)}</time>
              {p.data.readTime && <span>{p.data.readTime} min read</span>}
              {p.data.updated && <span>reviewed <time datetime={iso(p.data.updated)}>{fmt(p.data.updated)}</time></span>}
            </p>
          </a>
        ))}
      </div>
    </section>}

    <section aria-labelledby="acknowledgements" class="section">
      <h2 id="acknowledgements" class="eyebrow">Acknowledgements</h2>
      <p class="ack">{SITE.acknowledgement}</p>
    </section>
  </main>
</BaseLayout>
