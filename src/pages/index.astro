---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE, fmtShort, isoDate } from "../consts";

const posts = (await getCollection("blog")).sort(
  (a, b) =>
    b.data.date.valueOf() - a.data.date.valueOf() ||
    (a.data.part ?? 0) - (b.data.part ?? 0)
);
---
<BaseLayout title="Writing" nav="writing">
  <section class="intro" aria-labelledby="intro-title">
    <div>
      <div class="eyebrow">{SITE.eyebrow}</div>
      <h1 id="intro-title">{SITE.tagline}</h1>
      <p class="lead">{SITE.intro}</p>
      <p class="personal-note">{SITE.personalNote}</p>
    </div>
    <aside class="margin-note">
      <strong>Agent Sentinel</strong>
      A flight recorder for AI agents in regulated environments.
      <p><a href={SITE.series}>Read Part 1</a></p>
    </aside>
  </section>

  <section aria-labelledby="writing-title">
    <div class="section-label">
      <h2 id="writing-title">Latest writing</h2>
      <span>Agent Sentinel series</span>
    </div>
    {posts.map((p) => (
      <article class="post">
        <div>
          <div class="date"><time datetime={isoDate(p.data.date)}>{fmtShort(p.data.date)}</time></div>
          {p.data.readTime && <div class="meta">{p.data.readTime} min read</div>}
        </div>
        <div>
          <span class="tag">{p.data.tags.join(" · ")}</span>
          <h2><a href={`/blog/${p.id}/`}>{p.data.title}</a></h2>
          <p>{p.data.excerpt}</p>
          {p.data.image && (
            <a href={`/blog/${p.id}/`} tabindex="-1" aria-hidden="true">
              <img class="post-image" src={p.data.image} alt="" width="1200" height="627" loading="lazy" />
            </a>
          )}
        </div>
      </article>
    ))}
  </section>
</BaseLayout>
