---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { SITE, fmtLong, isoDate } from "../../consts";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const download = `/downloads/${post.id}`;
---
<BaseLayout title={post.data.title} description={post.data.excerpt} image={post.data.image} type="article" nav="writing">
  <article class="article">
    <a class="back" href="/">All writing</a>
    <div class="eyebrow" style="margin-top:32px">{post.data.tags.join(" · ")}</div>
    <h1>{post.data.title}</h1>
    <div class="meta">
      {SITE.name} · <time datetime={isoDate(post.data.date)}>{fmtLong(post.data.date)}</time>
      {post.data.readTime && <> · {post.data.readTime} min read</>}
    </div>
    <div class="article-downloads" role="group" aria-label="Download article">
      <a href={`${download}.md`} download={`${post.id}.md`}>Download Markdown</a>
      <a href={`${download}.html`} download={`${post.id}.html`}>Download HTML</a>
    </div>
    <div class="post-content">
      <Content />
    </div>
  </article>
</BaseLayout>
