---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { blogPostingJsonLd } from "../../structured-data";
import { SITE } from "../../consts";
import { getSeries } from "../../series";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
// Series navigation: published parts only, so nothing links to an unwritten part.
const allSeries = getSeries(await getCollection("blog"));
const series = allSeries.find((s) => s.name === post.data.series);
const idx = series ? series.parts.findIndex((p) => p.id === post.id) : -1;
const prev = idx > 0 ? series.parts[idx - 1] : undefined;
const next = series && idx >= 0 ? series.parts[idx + 1] : undefined;
const others = allSeries.filter((s) => s !== series);
const short = (title) => title.replace(/^.*Part \d+: /, "");
const { Content, headings } = await render(post);
// Table of contents: the post's own ## and ### headings. No JavaScript.
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);
const url = new URL(Astro.url.pathname, Astro.site);
const fmt = (d) => d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
const iso = (d) => d.toISOString().slice(0, 10);
// "Last reviewed" is the published date until series.json gives an "updated" date.
const reviewed = post.data.updated ?? post.data.date;
---
<BaseLayout title={post.data.title} description={post.data.excerpt} image={post.data.image} type="article"
  published={post.data.date} updated={post.data.updated} tags={post.data.tags} jsonLd={blogPostingJsonLd(post.data, url)}>
  <div class="container-wide post-layout">
    <article>
      <header class="post-header">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            {series && <li><a href={`/blog/${series.parts[0].id}/`}>{series.name}</a></li>}
            <li aria-current="page">{series ? `Part ${post.data.part}` : post.data.title}</li>
          </ol>
        </nav>
        <h1>{post.data.title}</h1>
        <p class="meta">
          <time datetime={iso(post.data.date)}>{fmt(post.data.date)}</time>
          {post.data.readTime && <span>{post.data.readTime} min read</span>}
        </p>
        <ul class="tags" aria-label="Tags">
          {post.data.tags.map((t) => <li class="chip">#{t}</li>)}
        </ul>
      </header>

      <aside class="provenance" aria-label="About this post">
        <dl>
          <dt>Published</dt>
          <dd><time datetime={iso(post.data.date)}>{fmt(post.data.date)}</time></dd>
          <dt>Last reviewed</dt>
          <dd><time datetime={iso(reviewed)}>{fmt(reviewed)}</time></dd>
          {post.data.sources && post.data.sources.length > 0 && <>
            <dt>{post.data.sources.length === 1 ? "Source" : "Sources"}</dt>
            <dd><ul>
              {post.data.sources.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a></li>)}
            </ul></dd>
          </>}
        </dl>
      </aside>

      {toc.length > 1 && <details class="toc toc-mobile">
        <summary>On this page</summary>
        <ol>
          {toc.map((h) => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </details>}

      <div class="prose">
        <Content />
      </div>

      {series && <nav aria-label={`${series.name} series`} class="card series-box">
        <p class="eyebrow">
          {series.name} · Part {post.data.part} · {series.parts.length} {series.parts.length === 1 ? "part" : "parts"} published
        </p>
        {series.question && <p class="question">{series.question}</p>}
        {(prev || next) && <div class="series-nav">
          {prev && <a href={`/blog/${prev.id}/`}>
            <small>← Previous in this series</small>
            Part {prev.data.part}: {short(prev.data.title)}
          </a>}
          {next && <a href={`/blog/${next.id}/`} class="next">
            <small>Next in this series →</small>
            Part {next.data.part}: {short(next.data.title)}
          </a>}
        </div>}
        {series.codeUrl && <p class="divider">
          <a href={series.codeUrl} target="_blank" rel="noopener noreferrer">View implementation: source code on GitHub</a>
        </p>}
        {others.map((o) => (
          <p class="divider">
            <span class="eyebrow other-label">The other side of the question</span>
            {o.question && <strong class="other-question">{o.question}</strong>}
            <a href={`/blog/${o.parts[0].id}/`}>{o.name}, Part 1: {short(o.parts[0].data.title)}</a>
          </p>
        ))}
        <p class="divider footnote">{SITE.question}</p>
      </nav>}
    </article>

    {toc.length > 1 && <aside class="toc toc-side">
      <nav aria-label="Table of contents">
        <p class="eyebrow">On this page</p>
        <ol>
          {toc.map((h) => <li class={`depth-${h.depth}`}><a href={`#${h.slug}`}>{h.text}</a></li>)}
        </ol>
      </nav>
    </aside>}
  </div>
</BaseLayout>
