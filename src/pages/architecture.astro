---
// Cross-cutting landing page: every post tagged "Architecture" (set per part
// with "topics" in a series.json), grouped by series, followed by the decision
// records (<folder>/docs/adr/*.md) those posts rest on. It is a view over the
// existing posts, not a third series.
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { SITE } from "../consts";
import { getSeries } from "../series";

const A = SITE.architecture;
const all = await getCollection("blog");
const posts = all
  .filter((p) => p.data.tags.includes(A.tag))
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf() || (a.data.part ?? 0) - (b.data.part ?? 0));

// Series posts keep their series order; anything else is a standalone note.
const groups = getSeries(all)
  .map((s) => ({ ...s, parts: s.parts.filter((p) => p.data.tags.includes(A.tag)) }))
  .filter((s) => s.parts.length > 0);
const grouped = new Set(groups.flatMap((s) => s.parts.map((p) => p.id)));
const standalone = posts.filter((p) => !grouped.has(p.id)).reverse(); // newest first

// Decision records, read straight from each series folder.
const REPO = `${SITE.github}/anandnarayanan-blog/blob/main`;
const records = Object.entries(
  import.meta.glob<string>("/*/docs/adr/*.md", { eager: true, query: "?raw", import: "default" }),
)
  .map(([path, text]) => ({
    url: REPO + path,
    title: text.match(/^# (.+)$/m)?.[1] ?? path.split("/").pop(),
    status: text.match(/^\*\*Status:\*\*\s*(.+)$/m)?.[1],
    date: text.match(/^\*\*Date:\*\*\s*(\d{4}-\d{2}-\d{2})/m)?.[1],
    series: path.split("/")[1],
  }))
  .sort((a, b) => a.url.localeCompare(b.url));

const fmt = (d) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "2-digit", timeZone: "UTC" });
const iso = (d) => d.toISOString().slice(0, 10);
---
<BaseLayout title={`${A.title} — ${SITE.name}`} description={`${A.lead} ${A.intro}`}>
  <main class="container">
    <section class="hero">
      <h1>{A.title}</h1>
      <p class="lead">{A.lead}</p>
      <p class="intro">{A.intro}</p>
    </section>

    {groups.length > 0 && <section aria-labelledby="from-series" class="section">
      <h2 id="from-series" class="eyebrow">From the series</h2>
      {groups.map((s) => (
        <>
          <h3 class="group-title">{s.name}</h3>
          <div class="grid">
            {s.parts.map((p) => (
              <a href={`/blog/${p.id}/`} class="card">
                <span class="chip chip-accent">Part {p.data.part}</span>
                <h3>{p.data.title.replace(/^.*Part \d+: /, "")}</h3>
                <p class="summary">{p.data.excerpt}</p>
                <p class="meta">
                  <time datetime={iso(p.data.date)}>{fmt(p.data.date)}</time>
                  {p.data.readTime && <span>{p.data.readTime} min read</span>}
                </p>
              </a>
            ))}
          </div>
        </>
      ))}
    </section>}

    {standalone.length > 0 && <section aria-labelledby="design-notes" class="section">
      <h2 id="design-notes" class="eyebrow">Design notes</h2>
      <div class="grid">
        {standalone.map((p) => (
          <a href={`/blog/${p.id}/`} class="card">
            <h3>{p.data.title}</h3>
            <p class="summary">{p.data.excerpt}</p>
            <p class="meta">
              <time datetime={iso(p.data.date)}>{fmt(p.data.date)}</time>
              {p.data.readTime && <span>{p.data.readTime} min read</span>}
            </p>
          </a>
        ))}
      </div>
    </section>}

    {records.length > 0 && <section aria-labelledby="decision-records" class="section">
      <h2 id="decision-records" class="eyebrow">Decision records</h2>
      <p class="section-note">The context, the options that were rejected and the consequences, as recorded when the decision was made.</p>
      <ul class="records">
        {records.map((r) => (
          <li>
            <a href={r.url} target="_blank" rel="noopener noreferrer">{r.title}</a>
            <p class="meta">
              <span>{r.series}</span>
              {r.status && <span>{r.status}</span>}
              {r.date && <time datetime={r.date}>{r.date}</time>}
            </p>
          </li>
        ))}
      </ul>
    </section>}
  </main>
</BaseLayout>
