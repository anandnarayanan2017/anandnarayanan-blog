---
import "../styles/global.css";
import { SITE } from "../consts";
// published/updated/tags: set on articles (og article:* tags). jsonLd: one schema.org
// object or an array of them, rendered as JSON-LD.
const { title, description, image, type = "website", published, updated, tags = [], jsonLd } = Astro.props;
const pageTitle = title ?? SITE.name;
const pageDescription = description ?? SITE.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? SITE.ogImage, Astro.site);
// Escape "<" so content can never close the script element early.
const ldJson = jsonLd && JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="author" content={SITE.name} />
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
    <link rel="canonical" href={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta name="twitter:card" content="summary_large_image" />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {updated && <meta property="article:modified_time" content={updated.toISOString()} />}
    {type === "article" && <meta property="article:author" content={SITE.linkedin} />}
    {tags.map((t) => <meta property="article:tag" content={t} />)}
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — RSS`} href="/rss.xml" />
    {ldJson && <script type="application/ld+json" set:html={ldJson} />}
    <script is:inline>
      const t = localStorage.getItem("theme");
      if (t === "dark" || (!t && matchMedia("(prefers-color-scheme: dark)").matches))
        document.documentElement.classList.add("dark");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <header class="site-header">
      <div class="container-wide">
        <a href="/" class="site-name">{SITE.name}</a>
        <nav class="site-nav" aria-label="Site">
          <a href="/about/" class="nav-link">About</a>
          <a href="/rss.xml" class="nav-link">RSS</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (opens in a new tab)" class="icon-btn">
            <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M4.98 3.5A2.5 2.5 0 1 1 0 3.5a2.5 2.5 0 0 1 4.98 0M0 8h5v16H0zm7.5 0H12v2.2h.07c.63-1.2 2.17-2.46 4.46-2.46C21.28 7.74 24 10 24 14.6V24h-5v-8.3c0-2-.04-4.5-2.75-4.5-2.75 0-3.17 2.15-3.17 4.36V24h-5z"/></svg>
          </a>
          <button id="theme-toggle" type="button" aria-label="Toggle dark mode" class="icon-btn">
            <svg aria-hidden="true" class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9"/></svg>
            <svg aria-hidden="true" class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4m11.4-11.4 1.4-1.4"/></svg>
          </button>
        </nav>
      </div>
    </header>

    <div id="content" class="page">
      <slot />
    </div>

    <footer class="site-footer">
      <div class="container-wide">
        <div>
          <p>© {new Date().getFullYear()} {SITE.name}</p>
          <p>Content <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="license noopener noreferrer">CC BY 4.0</a> · Code Apache 2.0</p>
          <p>Personal writing and projects · Full-time Solutions Architect</p>
        </div>
        <div class="footer-links">
          <a href="/rss.xml">RSS</a>
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={SITE.seriesRepo} target="_blank" rel="noopener noreferrer">Agent Sentinel code</a>
          <a href={`mailto:${SITE.email}`}>Email</a>
        </div>
      </div>
    </footer>

    <!-- External file, not an inline script, so a strict CSP can allow it with 'self'. -->
    <script is:inline src="/js/site.js" defer></script>
  </body>
</html>
