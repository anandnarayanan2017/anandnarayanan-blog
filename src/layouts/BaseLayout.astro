---
import "../styles/global.css";
import { SITE } from "../consts";
const { title, description, image, type = "website", nav } = Astro.props;
const pageTitle = title ? `${title} · ${SITE.name}` : SITE.name;
const ogTitle = title ?? SITE.name;
const pageDescription = description ?? SITE.tagline;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? SITE.ogImage, Astro.site);
const links = [
  { id: "writing", href: "/", label: "Writing" },
  { id: "about", href: "/about/", label: "About" },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header>
      <div class="wrap top">
        <a class="brand" href="/"><span>an.</span>{SITE.name}</a>
        <nav aria-label="Main navigation">
          {links.map((l) => (
            <a href={l.href} class:list={{ active: nav === l.id }} aria-current={nav === l.id ? "page" : undefined}>{l.label}</a>
          ))}
          <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer>
      <div class="wrap bottom">
        <div>
          <span>© {new Date().getFullYear()} {SITE.name}</span>
          <p class="personal-footer">{SITE.footerNote}</p>
        </div>
        <div class="footer-links">
          <a href={SITE.github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={SITE.seriesRepo} target="_blank" rel="noopener noreferrer">Agent Sentinel code</a>
          <a href={`mailto:${SITE.email}`}>Email</a>
        </div>
      </div>
    </footer>
  </body>
</html>
